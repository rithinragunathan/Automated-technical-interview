# Database
DB_URL=jdbc:postgresql://postgres:5432/mockinterview
DB_USERNAME=mockuser
DB_PASSWORD=change_this_password_in_production
POSTGRES_DB=mockinterview
POSTGRES_USER=mockuser
POSTGRES_PASSWORD=change_this_password_in_production

# JWT
JWT_SECRET=change-this-to-a-random-256-bit-secret-in-production-never-use-default
JWT_EXPIRATION_MS=86400000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring
SPRING_PROFILE=dev

# AI Provider (mock | openai)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Sandbox
SANDBOX_JAVA_IMAGE=openjdk:21-alpine
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_BYTES=268435456
SANDBOX_WORKSPACE=/tmp/sandbox
DOCKER_HOST=unix:///var/run/docker.sock

# Sandbox Worker URL (used by backend to call worker)
SANDBOX_WORKER_URL=http://sandbox-worker:8081
