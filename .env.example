# Database
DB_URL=jdbc:mysql://mysql:3306/mockinterview?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=mockuser
DB_PASSWORD=mockpass
MYSQL_DATABASE=mockinterview
MYSQL_USER=mockuser
MYSQL_PASSWORD=mockpass
MYSQL_ROOT_PASSWORD=rootpass

# JWT
JWT_SECRET=change-this-to-a-random-256-bit-secret-with-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring
SPRING_PROFILE=dev

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:80

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/
GEMINI_MODEL=gemini-2.5-flash

# Sandbox
SANDBOX_JAVA_IMAGE=eclipse-temurin:21-jdk-alpine
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_BYTES=268435456
SANDBOX_WORKSPACE=/tmp/sandbox
SANDBOX_WORKSPACE_VOLUME=mockinterview-sandbox-workspace
DOCKER_HOST=npipe:////./pipe/docker_engine

# Sandbox Worker URL (used by backend to call worker)
SANDBOX_WORKER_URL=http://sandbox-worker:8081
